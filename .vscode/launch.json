  "version": "0.2.0",
  "configurations": [
    {
      "name": "Arc UI example (macOS)",
      "request": "launch",
      "type": "dart",
      "program": "example/lib/main.dart",
      "deviceId": "macos",
      "args": ["--enable-impeller"]
    },
    {
      "name": "arc_ui",
      "request": "launch",
      "type": "dart",
      "args": ["--enable-impeller"]
    },
    {
      "name": "arc_ui (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": ["--enable-impeller"]
    },
    {
      "name": "arc_ui (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--enable-impeller"]
    },
    {
      "name": "arc_ui sandbox (widgetbook)",
      "request": "launch",
      "type": "dart",
      "program": "widgetbook/lib/main.dart",
      "deviceId": "macos",
      "args": ["--enable-impeller"]
    }
  ]
}
